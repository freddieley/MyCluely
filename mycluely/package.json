{
  "name": "vela",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "assets": "powershell -ExecutionPolicy Bypass -File scripts/fetch-assets.ps1",
    "assets:local": "powershell -ExecutionPolicy Bypass -File scripts/fetch-assets.ps1 -IncludeOllama",
    "build:cloud": "npm run assets && tauri build",
    "build:local": "powershell -ExecutionPolicy Bypass -File scripts/fetch-assets.ps1 -IncludeOllama && tauri build --config src-tauri/tauri.local.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
